# Usar Node.js 25.3 (más reciente, con OpenSSL actualizado)
FROM node:25.3-alpine AS builder

RUN apk update && \
    apk upgrade --no-cache && \
    rm -rf /var/cache/apk/*

WORKDIR /app

# Instalar dependencias
COPY package*.json ./
RUN npm ci --omit=dev

COPY certs/global-bundle.pem /app/certs/global-bundle.pem
COPY . .

# Imagen final
FROM node:25.3-alpine

RUN apk update && \
    apk upgrade --no-cache && \
    apk add --no-cache ca-certificates zlib>=1.3.2-r0 && \
    rm -rf /var/cache/apk/*

WORKDIR /app

# Copiar desde builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/certs ./certs
COPY --from=builder /app/src ./src
RUN rm -rf /usr/local/include/node && \
    rm -rf /usr/local/lib/node_modules/npm

# Verificar versiones
RUN echo "=== Node Version ===" && \
    node --version

# Usuario no privilegiado
RUN chown -R node:node /app

USER node

EXPOSE 4000

# Ejecutar directamente con node, no con npm
CMD ["node", "src/index.js"]